{
  "name": "@moben-ai/codex",
  "version": "0.1.0",
  "private": true,
  "description": "Follow and steer Codex tasks from a Moben device by voice.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/78/moben-codex.git"
  },
  "homepage": "https://github.com/78/moben-codex#readme",
  "bugs": "https://github.com/78/moben-codex/issues",
  "bin": {
    "moben-codex": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "tsx src/cli.ts run",
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node20 --format=cjs --external:@moben-ai/app-sdk --outfile=dist/cli.js",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@moben-ai/app-sdk": "^0.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
